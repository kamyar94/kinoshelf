# Copy to .env and fill in. No secrets here: the tunnel token lives only in cloudflared.env and API
# keys are entered on the Settings page (stored in ./data).

# Which compose files to use. Add :compose.local.yml or :compose.lan.yml for local access.
# (On Windows with Docker Desktop, separate with ; instead of :)
COMPOSE_FILE=docker-compose.yml:compose.media.yml:compose.local.yml
# Uncomment to start the Cloudflare Tunnel connector as well. Add route for the optional Xray
# sidecar that lookups can use on a filtered network (docs/NETWORK.md): COMPOSE_PROFILES=tunnel,route
# COMPOSE_PROFILES=tunnel

# The user and group that own your media folders (id -u, id -g on Linux/WSL).
PUID=1000
PGID=1000

# Time zone for the weekly move.
TZ=UTC

# Port inside and on the host (compose.local.yml / compose.lan.yml).
KS_PORT=8484
# LAN_IP=192.0.2.10

# Cloudflare Access (required with the tunnel): your team domain and the application's audience tag.
KS_CF_ACCESS_TEAM=
KS_CF_ACCESS_AUD=

CLOUDFLARED_VERSION=2026.10.0
XRAY_VERSION=26.9.30
KS_LOG_LEVEL=INFO
